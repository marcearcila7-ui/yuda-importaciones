# ───────── Stage 1: builder ─────────
FROM node:20-alpine AS builder

WORKDIR /app

# Instala dependencias
COPY package.json ./
RUN npm install

# Cache-bust: cambiar este valor fuerza a Railway a rehacer el build desde aquí
# (evita que reuse un dist viejo cacheado). Subilo si vuelve a quedar pegado.
ARG CACHE_BUST=2026-06-08-v3
RUN echo "build rev: $CACHE_BUST"

# Copia el resto del código
COPY . .

# URL del backend en producción (build arg de Vite)
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ───────── Stage 2: runner ─────────
FROM nginx:alpine AS runner

# Solo los archivos estáticos compilados (sin node_modules ni código fuente)
COPY --from=builder /app/dist /usr/share/nginx/html

# Plantilla de nginx: el entrypoint oficial corre envsubst al arrancar y sustituye
# ${PORT} por el puerto que inyecta Railway. NGINX_ENVSUBST_FILTER limita la
# sustitución a PORT para no tocar variables propias de nginx ($uri, $host, ...).
# PORT=80 es el default para correr la imagen localmente sin Railway.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
ENV PORT=80
ENV NGINX_ENVSUBST_FILTER=PORT

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
