DATABASE_URL=
SECRET_KEY=
TIPO_CAMBIO_USD=6.7
ANTHROPIC_API_KEY=
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_EXPIRE_HOURS=8

# Supabase Storage
SUPABASE_URL=          # URL del proyecto, ej: https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=  # service_role key de Settings → API

# Avisos al cliente cuando bodega marca "en bodega" (aprobar despacho).
# Si se dejan vacíos, ese aviso simplemente no se envía; el resto del sistema sigue igual.
BREVO_API_KEY=          # API key de Brevo (Settings → SMTP & API → API Keys)
BREVO_SENDER_EMAIL=     # remitente verificado en Brevo, ej: pedidos@yudatrading.co
BREVO_SENDER_NAME=YUDA Importaciones
LUCIDBOT_API_KEY=       # API key de Lucid Bot (panel.lucidbot.co → API/Integraciones)
LUCIDBOT_API_URL=https://api.chatrace.com
# Fuera de la ventana de 24h de WhatsApp hay que usar una plantilla, no texto libre.
# Deja esto vacío mientras pruebas dentro de las 24h; cuando tengas el flow con la
# plantilla armado en Lucid Bot, pon aquí su id (lo ves en /accounts/flows).
LUCIDBOT_FLOW_APROBAR_DESPACHO=
# Mismos flows, para los otros dos avisos automáticos al cliente (pedido enviado
# al proveedor, y fecha tentativa que dio el proveedor). Cada uno con su propia
# plantilla aprobada de WhatsApp.
LUCIDBOT_FLOW_PEDIDO_ENVIADO=
LUCIDBOT_FLOW_FECHA_TENTATIVA=
# Nombres de los custom fields en Lucid Bot donde se dejan las variables antes de
# disparar el flow de arriba. Créalos en Lucid Bot con estos nombres exactos (o
# cambia estos valores para que coincidan con los tuyos).
LUCIDBOT_CF_NUMERO_PEDIDO=yuda_numero_pedido
LUCIDBOT_CF_PLAZO=yuda_plazo_aprobacion
LUCIDBOT_CF_LINK=yuda_link_portal
LUCIDBOT_CF_NOTA=yuda_nota_bodega
LUCIDBOT_CF_FECHA_TENTATIVA=yuda_fecha_tentativa
PORTAL_URL=http://localhost:3000  # dominio público del portal, para el link del aviso
