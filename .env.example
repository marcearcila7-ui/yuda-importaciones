DATABASE_URL=
SECRET_KEY=
TIPO_CAMBIO_USD=6.7
ANTHROPIC_API_KEY=
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_EXPIRE_HOURS=8

# Supabase Storage
SUPABASE_URL=          # URL del proyecto, ej: https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=  # service_role key de Settings → API

# Correo de "olvidé mi contraseña" (SMTP de Gmail). Vacío = el enlace de
# recuperación queda solo en los logs, no falla nada (útil en desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=          # contraseña de aplicación de Gmail, no la contraseña normal
SMTP_FROM=              # opcional, si se deja vacío se usa SMTP_USER
