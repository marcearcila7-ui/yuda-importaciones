# Base de datos
POSTGRES_USER=yuda
POSTGRES_PASSWORD=           # cambiar por contraseña segura
POSTGRES_DB=yuda_prod
DATABASE_URL=postgresql://yuda:PASSWORD@postgres:5432/yuda_prod

# Seguridad
SECRET_KEY=                  # cadena aleatoria larga, mínimo 32 caracteres

# API externa
ANTHROPIC_API_KEY=           # key de console.anthropic.com

# Aplicación
TIPO_CAMBIO_USD=6.7
UPLOAD_DIR=/app/uploads
CORS_ORIGINS=https://tu-dominio-frontend.vercel.app
ACCESS_TOKEN_EXPIRE_HOURS=8

# Frontend build
VITE_API_URL=https://tu-dominio-backend.com

# Supabase Storage
SUPABASE_URL=          # URL del proyecto, ej: https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=  # service_role key de Settings → API

# Correo de "olvidé mi contraseña" (SMTP de Gmail). Vacío = el enlace de
# recuperación queda solo en los logs, no falla nada.
SMTP_HOST=              # smtp.gmail.com
SMTP_PORT=587
SMTP_USER=              # la cuenta de Gmail que manda el correo
SMTP_PASSWORD=          # contraseña de aplicación de Gmail (Cuenta → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones)
SMTP_FROM=              # opcional, si se deja vacío se usa SMTP_USER
