# Base de datos
POSTGRES_USER=yuda
POSTGRES_PASSWORD=           # cambiar por contraseña segura
POSTGRES_DB=yuda_prod
DATABASE_URL=postgresql://yuda:PASSWORD@postgres:5432/yuda_prod

# Seguridad
SECRET_KEY=                  # cadena aleatoria larga, mínimo 32 caracteres

# API externa
ANTHROPIC_API_KEY=           # key de console.anthropic.com

# Aplicación
TIPO_CAMBIO_USD=6.7
UPLOAD_DIR=/app/uploads
CORS_ORIGINS=https://tu-dominio-frontend.vercel.app
ACCESS_TOKEN_EXPIRE_HOURS=8

# Frontend build
VITE_API_URL=https://tu-dominio-backend.com

# Supabase Storage
SUPABASE_URL=          # URL del proyecto, ej: https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=  # service_role key de Settings → API

# Avisos al cliente cuando bodega marca "en bodega" (aprobar despacho)
BREVO_API_KEY=          # API key de Brevo (Settings → SMTP & API → API Keys)
BREVO_SENDER_EMAIL=     # remitente verificado en Brevo, ej: pedidos@yudatrading.co
BREVO_SENDER_NAME=YUDA Importaciones
LUCIDBOT_API_KEY=       # API key de Lucid Bot (panel.lucidbot.co → API/Integraciones)
LUCIDBOT_API_URL=https://api.chatrace.com
LUCIDBOT_FLOW_APROBAR_DESPACHO=  # id del flow con la plantilla (ver /accounts/flows)
LUCIDBOT_FLOW_PEDIDO_ENVIADO=
LUCIDBOT_FLOW_FECHA_TENTATIVA=
LUCIDBOT_CF_NUMERO_PEDIDO=yuda_numero_pedido
LUCIDBOT_CF_PLAZO=yuda_plazo_aprobacion
LUCIDBOT_CF_LINK=yuda_link_portal
LUCIDBOT_CF_NOTA=yuda_nota_bodega
LUCIDBOT_CF_FECHA_TENTATIVA=yuda_fecha_tentativa
PORTAL_URL=https://tu-dominio-frontend.vercel.app
